# Copy to .env (gitignored) and fill in. Never commit real keys.
# Azure Speech (npm run tts, default provider)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=southeastasia

# Piper (npm run tts -- --provider piper): path to a Vietnamese .onnx voice model
PIPER_MODEL=/path/to/vi_VN-voice.onnx

# Preview deployments only: include draft lessons (reviewed: false) in `vite build`
# PLAYCHESS_INCLUDE_DRAFTS=1
