# Copy to .env (gitignored) and fill in. Never commit real keys.
# Piper (npm run tts, default provider). npm run tts:setup downloads Piper, the voice and ffmpeg
# into .tools/, which is used automatically; set these only to use other copies.
# PIPER_BIN=C:/path/to/piper.exe
# PIPER_MODEL=C:/path/to/vi_VN-vais1000-medium.onnx
# FFMPEG_BIN=C:/path/to/ffmpeg.exe

# Azure Speech (not used; npm run tts -- --provider azure)
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=southeastasia

# Preview deployments only: include draft lessons (reviewed: false) in `vite build`
# PLAYCHESS_INCLUDE_DRAFTS=1
