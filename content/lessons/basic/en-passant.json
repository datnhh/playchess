      "assert": [{ "type": "pieceAt", "square": "d6", "piece": "wP" }]
    },
    {
      "kind": "interactMove",
      "id": "capture-star",
      "say": "Tốt đen vừa đi hai ô. Bé bắt tốt qua đường nhé!",
      "actions": [
        { "type": "setPosition", "position": "4k3/5p2/8/4P3/8/8/8/4K3 b - - 0 1" },
        { "type": "clear", "target": "all" },
        { "type": "move", "from": "f7", "to": "f5" },
        { "type": "stickers", "items": [{ "square": "f6", "kind": "star" }] }
