      "assert": [{ "type": "pieceAt", "square": "d5", "piece": "bP" }]
    },
    {
      "kind": "tapSquare",
      "id": "tap-black-pawn",
      "say": "Bé chạm vào Tốt đen vừa đi hai ô nhé.",
      "answers": ["d5"],
      "retry": "Chưa đúng rồi. Tốt đen đứng ngay cạnh Tốt của bé."
    },
    {
      "kind": "watch",
      "id": "en-passant-name",
      "say": "Bé ăn nó như nó chỉ đi một ô. Đó là bắt tốt qua đường.",
      "actions": [
        { "type": "clear", "target": "all" },
        { "type": "highlight", "squares": ["d6"], "tone": "good" },
        { "type": "arrow", "from": "e5", "to": "d6", "tone": "good" }
      ]
    },
    {
      "kind": "watch",
      "id": "en-passant-demo",
      "say": "Xem này, Tốt đi chéo, và Tốt đen biến mất.",
      "actions": [
        { "type": "clear", "target": "all" },
        { "type": "move", "from": "e5", "to": "d6" }
