      "accept": [{ "from": "e5", "to": "f6" }],
      "praise": "Giỏi quá! Bé đã bắt tốt qua đường.",
      "retry": "Chưa đúng rồi. Tốt đi chéo tới ô ngôi sao nhé."
    },
    {
      "kind": "watch",
      "id": "only-right-away",
      "say": "Phải ăn ngay nước sau. Chờ lâu là không được nữa.",
      "actions": [
        { "type": "setPosition", "position": "4k3/8/8/3pP3/8/8/8/4K3 w - - 0 1" },
        { "type": "clear", "target": "all" },
        { "type": "arrow", "from": "e5", "to": "d6", "tone": "warn" }
      ]
    },
    {
      "kind": "interactMove",
      "id": "capture-heart",
      "say": "Bé thử lại nào, bắt Tốt đen ngay nhé.",
      "actions": [
        { "type": "setPosition", "position": "4k3/2p5/8/1P6/8/8/8/4K3 b - - 0 1" },
        { "type": "clear", "target": "all" },
        { "type": "move", "from": "c7", "to": "c5" },
        { "type": "stickers", "items": [{ "square": "c6", "kind": "heart" }] }
      ],
      "accept": [{ "from": "b5", "to": "c6" }],
      "praise": "Tuyệt quá! Bé bắt rất nhanh."
    },
    {
      "kind": "watch",
      "id": "goodbye",
      "say": "Bé đã học xong bắt tốt qua đường. Hẹn gặp lại bé nhé!",
      "actions": [
        { "type": "setPosition", "position": "4k3/8/8/8/8/8/8/4K3 w - - 0 1" },
        { "type": "clear", "target": "all" }
